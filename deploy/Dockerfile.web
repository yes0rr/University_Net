# ─────────────────────────────────────────────────────────────────────────────
#  Мини-приложение: статические файлы + веб-сервер с автоматическим HTTPS.
#
#  Сайт — чистая статика (проверено: к серверному API фронтенд не обращается,
#  все пути относительные). Поэтому uvicorn здесь не нужен, и образ получается
#  маленьким и быстрым. Файл main.py остаётся для локального запуска через
#  start.bat, где он удобен.
#
#  Раскладка внутри образа повторяет то, что ожидает index.html:
#      /srv/index.html          ← frontend/index.html
#      /srv/script.js           ← frontend/*.js и *.css
#      /srv/data/tomsk.json     ← data/tomsk.json  (загрузчик просит "data/tomsk.json")
# ─────────────────────────────────────────────────────────────────────────────

FROM caddy:2-alpine

# Статика мини-приложения в корень сайта
COPY frontend/ /srv/

# Данные кладём рядом — фронтенд забирает их по относительному пути data/*.json
COPY data/ /srv/data/

# Конфигурация с автоматическим HTTPS
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
