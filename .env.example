# Переменные для docker compose.
# Скопируйте файл в .env и заполните значения. Сам .env в репозиторий не идёт.

# Адрес мини-приложения — он же указывается в кабинете MAX в поле URL.
# Требования: только https://, до 1024 символов, латиница, цифры, точка, дефис.
#
# Без покупки домена IP превращается в имя так: точки заменяются на дефисы
# и добавляется .sslip.io
#   IP 45.153.69.132  ->  DOMAIN=45-153-69-132.sslip.io
DOMAIN=адрес-вашего-сервера.sslip.io
