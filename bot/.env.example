# Настройки бота. Скопируйте файл в bot/.env и заполните значения.
#   Windows (PowerShell):  Copy-Item bot\.env.example bot\.env
#   Linux:                 cp bot/.env.example bot/.env
#
# Сам файл bot/.env в репозиторий не попадает: он перечислен в .gitignore
# и в .dockerignore, поэтому секреты не уходят ни на GitHub, ни в образ.

# Токен бота из кабинета MAX. Обязателен: без него бот не запустится.
# Где взять: business.max.ru → «Чат-боты» → бот → «⋮» → Настройки.
MAX_BOT_TOKEN=

# Публичное имя бота (без @). Если не задать, не появится кнопка «Открыть в MAX».
MAX_BOT_NAME=t401_hakaton_max_bot

# Адрес мини-приложения для кнопки «Подобрать вуз».
# Должен совпадать с адресом, который привязан к боту в кабинете MAX.
MINI_APP_URL=https://45-153-69-132.sslip.io
